# GitHub OAuth credentials for custom deployments (e.g. organization study groups)
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set Authorized redirect URI to: https://github.com/
# Copy this file to .env and fill in your values before building
VITE_GITHUB_CLIENT_ID=your_client_id
VITE_GITHUB_CLIENT_SECRET=your_client_secret
